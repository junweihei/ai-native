# Local-only service binding. V1 rejects non-loopback hosts.
LEARNING_OS_HOST=127.0.0.1
LEARNING_OS_PORT=4173

# Reserved contract inputs. The skeleton does not read or write learning Markdown.
LEARNING_OS_REPO_ROOT=.
LEARNING_OS_MODE=read-only
LEARNING_OS_LOG_LEVEL=info
LEARNING_OS_PYTHON=

# Optional test-only fallback for a locally installed Playwright channel.
# Leave blank to install and use Playwright Chromium (the reproducible default).
LEARNING_OS_E2E_CHANNEL=
