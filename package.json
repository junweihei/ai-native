{
  "name": "ai-native-learning-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "tsx watch web/server/dev.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"web/**/*.{ts,tsx,css,html}\" \"*.{json,js,ts}\" \"scripts/*.mjs\" \"docs/development.md\" \"web/README.md\"",
    "test": "npm run test:unit && npm run test:component && npm run test:server",
    "test:unit": "vitest run --environment node web/tests/unit",
    "test:component": "vitest run --environment jsdom web/tests/component",
    "test:server": "vitest run --environment node web/tests/server",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
